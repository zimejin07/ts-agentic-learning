# Required: your Anthropic API key. Never commit the real .env file.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown). See LEARNING.md and README.md.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Hard cap on LLM acting turns (planning is extra). Mandatory safety valve.
AGENT_MAX_ITERATIONS=8

# Cumulative input+output tokens across the run. Leave 0/blank for unlimited.
AGENT_TOKEN_BUDGET=0

# How many assistant/user pairs to keep in history. 0 = never trim.
# Trim drops whole pairs so tool_use is never split from tool_result.
AGENT_KEEP_LAST_TURNS=6

# Extra LLM attempts after HTTP 429/5xx (2 means 3 tries total). Never retries 400.
AGENT_RETRY_ATTEMPTS=2
AGENT_RETRY_DELAY_MS=200

# Human approval for book_flight is a CLI flag, not env:
#   pnpm start --yes "…"     auto-approve
#   pnpm start "…"           y/n on a TTY; deny if piped

